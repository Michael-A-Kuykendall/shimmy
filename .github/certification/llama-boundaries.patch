 /// time since the last yield. Callers use `encoder` directly for compute
 /// passes; checkpoints call `yield_if_needed` or `force_yield`.
+pub(crate) fn diagnostic_boundary(edge: &str, operation: &str) {
+    if std::env::var("AIRFRAME_DIAGNOSTIC_BOUNDARIES").as_deref() == Ok("1") {
+        let timestamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_nanos();
+        eprintln!("METAL_BOUNDARY {timestamp} {edge} {operation}");
+    }
+}
