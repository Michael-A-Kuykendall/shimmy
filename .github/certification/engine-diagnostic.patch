diff --git a/src/runtime/metal_diagnostic.rs b/src/runtime/metal_diagnostic.rs
new file mode 100644
index 0000000..63081fb
--- /dev/null
+++ b/src/runtime/metal_diagnostic.rs
@@ -0,0 +1,320 @@
+//! Dev-only observations of actual production embedding buffers. No math overrides.
+#[path = "metal_upload_diagnostic.rs"]
+pub(super) mod upload;
+
+use super::GpuRuntime;
+use crate::backend::bindless::pipeline::DequantAnyParams;
+use serde_json::{json, Value};
+use wgpu::util::DeviceExt;
+
+fn read_bytes(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    source: &wgpu::Buffer,
+    offset: u64,
+    size: u64,
+) -> Vec<u8> {
+    let staging = device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("Embedding boundary readback"),
+        size,
+        usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    });
+    let mut encoder = device.create_command_encoder(&Default::default());
+    encoder.copy_buffer_to_buffer(source, offset, &staging, 0, size);
+    queue.submit(Some(encoder.finish()));
+    let slice = staging.slice(..);
+    let (tx, rx) = std::sync::mpsc::channel();
+    slice.map_async(wgpu::MapMode::Read, move |r| tx.send(r).unwrap());
+    device
+        .poll(wgpu::PollType::wait_indefinitely())
+        .expect("diagnostic poll");
+    rx.recv().unwrap().expect("diagnostic map");
+    let result = slice.get_mapped_range().to_vec();
+    staging.unmap();
+    result
+}
+
+fn metrics(actual: &[f32], expected: &[f32]) -> Value {
+    assert_eq!(actual.len(), expected.len());
+    let max_abs = actual
+        .iter()
+        .zip(expected)
+        .map(|(a, b)| f64::from(*a) - f64::from(*b))
+        .map(f64::abs)
+        .fold(0.0, f64::max);
+    let rms = (actual
+        .iter()
+        .zip(expected)
+        .map(|(a, b)| (f64::from(*a) - f64::from(*b)).powi(2))
+        .sum::<f64>()
+        / actual.len() as f64)
+        .sqrt();
+    json!({"max_abs":max_abs,"rms":rms,"finite":actual.iter().all(|x|x.is_finite()),"zeros":actual.iter().filter(|x|**x==0.0).count(),"first4":&actual[..4],"pass":max_abs<=0.00002 && actual.iter().all(|x|x.is_finite())})
+}
+
+impl GpuRuntime {
+    fn diagnostic_dequant(
+        &self,
+        buffer: &wgpu::Buffer,
+        bind_offset: u64,
+        bind_size: Option<std::num::NonZeroU64>,
+        row_word: u32,
+        inspect_words: bool,
+    ) -> Vec<f32> {
+        let params = DequantAnyParams {
+            blob_base_words: row_word,
+            offset_words: 0,
+            formula_index: 5,
+            count: self.spec.n_embd as u32,
+            chunk_words: self.model.chunk_words(),
+        };
+        let uniform = self
+            .device
+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("Diagnostic exact dequant params"),
+                contents: bytemuck::bytes_of(&params),
+                usage: wgpu::BufferUsages::UNIFORM,
+            });
+        let sentinel = vec![f32::NAN; self.spec.n_embd];
+        let output = self
+            .device
+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("Diagnostic dequant sentinel"),
+                contents: bytemuck::cast_slice(&sentinel),
+                usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            });
+        let mut entries = vec![
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                    buffer,
+                    offset: bind_offset,
+                    size: bind_size,
+                }),
+            },
+            wgpu::BindGroupEntry {
+                binding: 1,
+                resource: output.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: uniform.as_entire_binding(),
+            },
+        ];
+        for binding in 10..=16 {
+            entries.push(wgpu::BindGroupEntry {
+                binding,
+                resource: self.model.dummy_buf.as_entire_binding(),
+            });
+        }
+        let group = self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("Diagnostic exact production dequant"),
+            layout: &self.pipeline.dequant_any_bind_group_layout,
+            entries: &entries,
+        });
+        let debug_pipeline = inspect_words.then(|| {
+            let mut source = include_str!("../backend/bindless/sh_dequant_any.wgsl").to_owned();
+            source.push_str(&format!(r#"
+@compute @workgroup_size(64)
+fn diagnostic_read_words(@builtin(global_invocation_id) id:vec3<u32>) {{
+ let i=id.x;
+ if (i<10u) {{
+   let fields=array<u32,5>(params.blob_base_words,params.offset_words,params.count,params.formula_index,params.chunk_words);
+   output[i]=f32((fields[i/2u] >> (16u*(i%2u))) & 65535u);
+ }} else if (i<10u+{}u) {{
+   let j=i-10u;
+   output[i]=f32((read_blob(params.blob_base_words+j/2u) >> (16u*(j%2u))) & 65535u);
+ }}
+}}
+"#,self.row_bytes/2));
+            let shader=self.device.create_shader_module(wgpu::ShaderModuleDescriptor{label:Some("Actual read_blob checkpoint"),source:wgpu::ShaderSource::Wgsl(source.into())});
+            let layout=self.device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor{label:None,bind_group_layouts:&[&self.pipeline.dequant_any_bind_group_layout],push_constant_ranges:&[]});
+            self.device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor{label:Some("Actual read_blob checkpoint"),layout:Some(&layout),module:&shader,entry_point:Some("diagnostic_read_words"),compilation_options:Default::default(),cache:None})
+        });
+        let mut encoder = self.device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&Default::default());
+            pass.set_pipeline(
+                debug_pipeline
+                    .as_ref()
+                    .unwrap_or(&self.pipeline.dequant_any_pipeline),
+            );
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups((self.spec.n_embd as u32).div_ceil(64), 1, 1);
+        }
+        self.queue.submit(Some(encoder.finish()));
+        bytemuck::cast_slice(&read_bytes(
+            &self.device,
+            &self.queue,
+            &output,
+            0,
+            self.spec.n_embd as u64 * 4,
+        ))
+        .to_vec()
+    }
+
+    fn diagnostic_words(&self, buffer: &wgpu::Buffer, row_word: u32, count: u32) -> Vec<u32> {
+        let source = r#"
+struct Params { base:u32, count:u32, unused0:u32, unused1:u32 };
+@group(0) @binding(0) var<storage,read> input:array<u32>;
+@group(0) @binding(1) var<storage,read_write> output:array<u32>;
+@group(0) @binding(2) var<uniform> p:Params;
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>) {
+ if (gid.x == 0u) {output[0]=0x1234abcdu;output[1]=arrayLength(&input);output[2]=p.base;output[3]=p.count;}
+ if (gid.x < p.count) {output[gid.x+4u]=input[p.base+gid.x];}
+}"#;
+        let shader = self
+            .device
+            .create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some("Raw storage identity"),
+                source: wgpu::ShaderSource::Wgsl(source.into()),
+            });
+        let pipeline = self
+            .device
+            .create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: Some("Raw storage identity"),
+                layout: None,
+                module: &shader,
+                entry_point: Some("main"),
+                compilation_options: Default::default(),
+                cache: None,
+            });
+        let uniform = self
+            .device
+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("Raw identity params"),
+                contents: bytemuck::cast_slice(&[row_word, count, 0, 0]),
+                usage: wgpu::BufferUsages::UNIFORM,
+            });
+        let initial = vec![0xa5a5a5a5u32; count as usize + 4];
+        let output = self
+            .device
+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("Raw identity sentinel"),
+                contents: bytemuck::cast_slice(&initial),
+                usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            });
+        let group = self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: None,
+            layout: &pipeline.get_bind_group_layout(0),
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: buffer.as_entire_binding(),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: output.as_entire_binding(),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: uniform.as_entire_binding(),
+                },
+            ],
+        });
+        let mut encoder = self.device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&Default::default());
+            pass.set_pipeline(&pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(count.div_ceil(64), 1, 1);
+        }
+        self.queue.submit(Some(encoder.finish()));
+        bytemuck::cast_slice(&read_bytes(
+            &self.device,
+            &self.queue,
+            &output,
+            0,
+            u64::from(count + 4) * 4,
+        ))
+        .to_vec()
+    }
+
+    /// Dev-only, sequential checkpoint experiment. This API is not an inference route.
+    pub fn diagnose_embedding_storage(&self, token: u32, raw: &[u8], expected: &[f32]) -> Value {
+        assert_eq!(self.embd_quant_type, 12);
+        assert_eq!(raw.len() as u64, self.row_bytes);
+        assert_eq!(expected.len(), self.spec.n_embd);
+        let offset = self.embd_weight_offset + u64::from(token) * self.row_bytes;
+        let (chunk, word) = self.model.buffer_for_word((offset / 4) as u32);
+        let buffer = &self.model.gpu_buffers[chunk];
+        let local = u64::from(word) * 4;
+        assert!(
+            local + raw.len() as u64 <= buffer.size(),
+            "selected row must stay in one resident chunk"
+        );
+        // Observe untouched production computation BEFORE adding copies or waits.
+        let original = self.dequant_token_embd(token);
+        let copied = read_bytes(&self.device, &self.queue, buffer, local, raw.len() as u64);
+        let words = self.diagnostic_words(buffer, word, (raw.len() / 4) as u32);
+        let word_bytes: &[u8] = bytemuck::cast_slice(&words[4..]);
+        let repeated = self.dequant_token_embd(token);
+        let whole = self.diagnostic_dequant(buffer, 0, None, word, false);
+        let prefix = self.diagnostic_dequant(
+            buffer,
+            0,
+            std::num::NonZeroU64::new(local + raw.len() as u64),
+            word,
+            false,
+        );
+        let reader = self.diagnostic_dequant(buffer, 0, None, word, true);
+        let reader_params: Vec<u32> = reader[..10]
+            .chunks_exact(2)
+            .map(|v| (v[0] as u32) | ((v[1] as u32) << 16))
+            .collect();
+        let reader_bytes: Vec<u8> = reader[10..10 + raw.len() / 2]
+            .iter()
+            .flat_map(|x| (*x as u16).to_le_bytes())
+            .collect();
+
+        let alignment = u64::from(self.device.limits().min_storage_buffer_offset_alignment);
+        let aligned = local / alignment * alignment;
+        let span = local - aligned + raw.len() as u64;
+        let bounded = self.diagnostic_dequant(
+            buffer,
+            aligned,
+            std::num::NonZeroU64::new(span),
+            ((local - aligned) / 4) as u32,
+            false,
+        );
+        let row_buffer = self.device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("GPU-copied identical row"),
+            size: raw.len() as u64,
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::STORAGE,
+            mapped_at_creation: false,
+        });
+        let mut encoder = self.device.create_command_encoder(&Default::default());
+        encoder.copy_buffer_to_buffer(buffer, local, &row_buffer, 0, raw.len() as u64);
+        self.queue.submit(Some(encoder.finish()));
+        let gpu_row = self.diagnostic_dequant(&row_buffer, 0, None, 0, false);
+        let cpu_row = self.pipeline.run_dequant_any_blob(
+            &self.device,
+            &self.queue,
+            raw,
+            0,
+            self.spec.n_embd as u32,
+            self.embd_quant_type,
+        );
+        let mut rewrite = Value::Null;
+        if copied != raw {
+            // Controlled mutation only AFTER the baseline observations.
+            self.queue.write_buffer(buffer, local, raw);
+            self.queue.submit([]);
+            self.device
+                .poll(wgpu::PollType::wait_indefinitely())
+                .expect("rewrite completion");
+            let bytes = read_bytes(&self.device, &self.queue, buffer, local, raw.len() as u64);
+            rewrite = json!({"bytes_match":bytes==raw,"dequant":metrics(&self.dequant_token_embd(token),expected)});
+        }
+        json!({
+            "token":token,"absolute_byte_offset":offset,"chunk":chunk,"local_byte_offset":local,"buffer_size":buffer.size(),"chunk_words":self.model.chunk_words(),"row_bytes":raw.len(),"count":self.spec.n_embd,"workgroups":self.spec.n_embd.div_ceil(64),"bind_offset":aligned,"bind_size":span,
+            "raw_copy_matches":copied==raw,"raw_copy_zero_bytes":copied.iter().filter(|x|**x==0).count(),
+            "identity":{"sentinel_written":words[0]==0x1234abcd,"reported_array_words":words[1],"reported_base":words[2],"reported_count":words[3],"bytes_match":word_bytes==raw,"zero_words":words[4..].iter().filter(|x|**x==0).count()},
+            "original":metrics(&original,expected),"after_wait":metrics(&repeated,expected),
+            "whole_binding":metrics(&whole,expected),"prefix_binding":metrics(&prefix,expected),"read_blob_checkpoint":{"params":reader_params,"bytes_match":reader_bytes==raw},"bounded_binding":metrics(&bounded,expected),
+            "gpu_copied_row":metrics(&gpu_row,expected),"cpu_uploaded_row":metrics(&cpu_row,expected),"rewrite":rewrite
+        })
+    }
+}
diff --git a/src/runtime/metal_upload_diagnostic.rs b/src/runtime/metal_upload_diagnostic.rs
new file mode 100644
index 0000000..4fc7c46
--- /dev/null
+++ b/src/runtime/metal_upload_diagnostic.rs
@@ -0,0 +1,268 @@
+//! Isolate mapped initialization from later model-load allocations.
+use super::{read_bytes, GpuRuntime};
+use crate::backend::bindless::loader::BindlessModel;
+use serde_json::{json, Value};
+use std::io::{Read, Seek, SeekFrom, Write};
+use wgpu::util::DeviceExt;
+
+pub(crate) fn capture_load(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    model: &BindlessModel,
+    path: &std::path::Path,
+    stage: &str,
+) {
+    let Ok(output) = std::env::var("AIRFRAME_METAL_LOAD_TRACE_PATH") else {
+        return;
+    };
+    let selected = std::env::var("AIRFRAME_METAL_LOAD_STAGE").unwrap_or_else(|_| "all".into());
+    if selected != "all" && selected != stage {
+        return;
+    }
+    let action = std::env::var("AIRFRAME_METAL_LOAD_ACTION").unwrap_or_else(|_| "readback".into());
+    if action != "readback" {
+        match action.as_str() {
+            "submit" => {
+                queue.submit([]);
+            }
+            "wait" => {
+                queue.submit([]);
+                device
+                    .poll(wgpu::PollType::wait_indefinitely())
+                    .expect("load diagnostic wait");
+            }
+            "poll" => {
+                device
+                    .poll(wgpu::PollType::wait_indefinitely())
+                    .expect("load diagnostic poll");
+            }
+            _ => panic!("invalid load diagnostic action"),
+        }
+        let mut out = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(output)
+            .expect("diagnostic trace");
+        writeln!(out, "{}", json!({"stage":stage,"action":action})).unwrap();
+        return;
+    }
+    let Some(tensor) = model.validated().manifest().tensor("token_embd.weight") else {
+        return;
+    };
+    if tensor.ggml_type() != 12 || tensor.row_bytes() != 1152 {
+        return;
+    }
+    let mut file = std::fs::File::open(path).expect("diagnostic model");
+    let mut rows = Vec::new();
+    for token in [11_u32, 151644] {
+        let offset = tensor.absolute_offset() + u64::from(token) * tensor.row_bytes();
+        let (chunk, word) = model.buffer_for_word((offset / 4) as u32);
+        let mut cpu = vec![0; 1152];
+        file.seek(SeekFrom::Start(offset)).unwrap();
+        file.read_exact(&mut cpu).unwrap();
+        let gpu = read_bytes(
+            device,
+            queue,
+            &model.gpu_buffers[chunk],
+            u64::from(word) * 4,
+            1152,
+        );
+        rows.push(json!({"token":token,"byte_offset":offset,"matches":cpu==gpu,"zero_bytes":gpu.iter().filter(|x|**x==0).count()}));
+    }
+    let mut out = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(output)
+        .expect("diagnostic trace");
+    writeln!(out, "{}", json!({"stage":stage,"rows":rows})).unwrap();
+}
+
+fn samples(size: u64) -> Vec<(u64, u64)> {
+    vec![
+        (0, 256),
+        (261225248, 1152),
+        (435906464, 1152),
+        (size - 256, 256),
+    ]
+}
+
+fn inspect(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+    buffer: &wgpu::Buffer,
+    expected_samples: &[(u64, Vec<u8>)],
+) -> Vec<Value> {
+    expected_samples.iter().map(|(offset,expected)| {
+        let gpu=read_bytes(device,queue,buffer,*offset,expected.len() as u64);
+        json!({"offset":offset,"size":expected.len(),"matches":gpu.as_slice()==expected.as_slice(),"zero_bytes":gpu.iter().filter(|x|**x==0).count(),"cpu_zero_bytes":expected.iter().filter(|x|**x==0).count()})
+    }).collect()
+}
+
+impl GpuRuntime {
+    /// Dev-only sequential allocation/API control; never substitutes inference.
+    pub async fn diagnose_buffer_upload(
+        path: &std::path::Path,
+        output: &std::path::Path,
+    ) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
+        let file = std::fs::File::open(path)?;
+        let file_len = file.metadata()?.len();
+        let instance = wgpu::Instance::new(&wgpu::InstanceDescriptor {
+            flags: wgpu::InstanceFlags::default().with_env(),
+            ..Default::default()
+        });
+        let adapters = instance.enumerate_adapters(wgpu::Backends::all());
+        let adapter = adapters
+            .iter()
+            .find(|a| a.get_info().device_type == wgpu::DeviceType::DiscreteGpu)
+            .or_else(|| {
+                adapters
+                    .iter()
+                    .find(|a| a.get_info().device_type == wgpu::DeviceType::IntegratedGpu)
+            })
+            .or_else(|| adapters.first())
+            .ok_or("no GPU")?;
+        let actual = adapter.limits();
+        let mut limits = wgpu::Limits::downlevel_defaults();
+        limits.max_storage_buffer_binding_size = actual.max_storage_buffer_binding_size;
+        limits.max_buffer_size = actual.max_buffer_size;
+        limits.max_storage_buffers_per_shader_stage =
+            actual.max_storage_buffers_per_shader_stage.max(14);
+        limits.max_compute_invocations_per_workgroup = 256;
+        let (device, queue) = adapter
+            .request_device(&wgpu::DeviceDescriptor {
+                required_limits: limits,
+                memory_hints: wgpu::MemoryHints::Performance,
+                ..Default::default()
+            })
+            .await?;
+        let usage = wgpu::BufferUsages::STORAGE
+            | wgpu::BufferUsages::COPY_DST
+            | wgpu::BufferUsages::COPY_SRC;
+        let pair_mode = std::env::var("AIRFRAME_METAL_UPLOAD_VARIANTS")
+            .ok()
+            .as_deref()
+            == Some("pairs");
+        let methods: &[&str] = if pair_mode {
+            &["device-ext-pair", "device-ext-pair-flushed"]
+        } else {
+            &[
+                "device-ext",
+                "device-ext-drop-source",
+                "explicit-mapped",
+                "bounded-queue",
+            ]
+        };
+        let mut results = Vec::new();
+        let info = adapter.get_info();
+        for size in [512 * 1024 * 1024_u64, 1024 * 1024 * 1024, file_len] {
+            assert!(size <= actual.max_buffer_size && size <= file_len);
+            for &method in methods {
+                // Immutable SHA-pinned fixture, remapped independently for each control.
+                let mut backing = Some(unsafe { memmap2::Mmap::map(&file)? });
+                let bytes = &backing.as_ref().unwrap()[..size as usize];
+                let expected_samples: Vec<_> = samples(size)
+                    .iter()
+                    .map(|(o, n)| (*o, bytes[*o as usize..(o + n) as usize].to_vec()))
+                    .collect();
+                let started = std::time::Instant::now();
+                let mut cpu_mapped_match = None;
+                let buffer = if method.starts_with("device-ext") {
+                    device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                        label: Some("Isolated DeviceExt upload"),
+                        contents: bytes,
+                        usage,
+                    })
+                } else {
+                    let mapped = method == "explicit-mapped";
+                    let b = device.create_buffer(&wgpu::BufferDescriptor {
+                        label: Some("Isolated upload control"),
+                        size,
+                        usage,
+                        mapped_at_creation: mapped,
+                    });
+                    if mapped {
+                        let mut view = b.slice(..).get_mapped_range_mut();
+                        view.copy_from_slice(bytes);
+                        cpu_mapped_match = Some(samples(size).iter().all(|(o, n)| {
+                            view[*o as usize..(o + n) as usize]
+                                == bytes[*o as usize..(o + n) as usize]
+                        }));
+                        drop(view);
+                        b.unmap();
+                    } else {
+                        for (chunk, data) in bytes.chunks(16 * 1024 * 1024).enumerate() {
+                            queue.write_buffer(&b, (chunk * 16 * 1024 * 1024) as u64, data);
+                            queue.submit([]);
+                            device.poll(wgpu::PollType::wait_indefinitely())?;
+                        }
+                    }
+                    b
+                };
+                if method == "device-ext-drop-source" {
+                    drop(backing.take());
+                }
+                let mut peer_backing = if pair_mode {
+                    Some(unsafe { memmap2::MmapOptions::new().map_copy(&file)? })
+                } else {
+                    None
+                };
+                let peer_expected = if let Some(data) = peer_backing.as_mut() {
+                    for (offset, length) in samples(size) {
+                        for j in 0..length {
+                            data[(offset + j) as usize] = ((j % 251) as u8) ^ 0xa7;
+                        }
+                    }
+                    Some(
+                        samples(size)
+                            .iter()
+                            .map(|(o, n)| (*o, data[*o as usize..(o + n) as usize].to_vec()))
+                            .collect::<Vec<_>>(),
+                    )
+                } else {
+                    None
+                };
+                let peer = if method.starts_with("device-ext-pair") {
+                    if method.ends_with("flushed") {
+                        queue.submit([]);
+                        device.poll(wgpu::PollType::wait_indefinitely())?;
+                    }
+                    Some(
+                        device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                            label: Some("Second pending initialized buffer"),
+                            contents: &peer_backing.as_ref().unwrap()[..size as usize],
+                            usage,
+                        }),
+                    )
+                } else {
+                    None
+                };
+                let values = inspect(&device, &queue, &buffer, &expected_samples);
+                let peer_samples = peer
+                    .as_ref()
+                    .map(|b| inspect(&device, &queue, b, peer_expected.as_ref().unwrap()));
+
+                let pass = values.iter().all(|v| v["matches"] == true)
+                    && peer_samples
+                        .as_ref()
+                        .is_none_or(|s| s.iter().all(|v| v["matches"] == true));
+                results.push(json!({"size":size,"method":method,"source_dropped_before_submit":method=="device-ext-drop-source","cpu_mapped_samples_match":cpu_mapped_match,"samples":values,"peer_samples":peer_samples,"peer_payload_distinct":pair_mode,"pass":pass,"elapsed":started.elapsed().as_secs_f64()}));
+                std::fs::write(
+                    output,
+                    serde_json::to_vec_pretty(
+                        &json!({"kind":if pair_mode{"pairs"}else{"single"},"complete":false,"adapter":info.name,"backend":format!("{:?}",info.backend),"limits":format!("{:?}",actual),"results":results}),
+                    )?,
+                )?;
+                drop(peer);
+                drop(buffer);
+                device.poll(wgpu::PollType::wait_indefinitely())?;
+            }
+        }
+        std::fs::write(
+            output,
+            serde_json::to_vec_pretty(
+                &json!({"kind":if pair_mode{"pairs"}else{"single"},"complete":true,"adapter":info.name,"backend":format!("{:?}",info.backend),"limits":format!("{:?}",actual),"results":results}),
+            )?,
+        )?;
+        Ok(())
+    }
+}
