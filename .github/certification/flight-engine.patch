@@ -0,0 +1,48 @@
+//! Opt-in shared-memory flight recorder; initialization happens before model loading.
+mod core;
+pub(crate) use core::label_id;
+use std::sync::OnceLock;
+
+struct Recorder {
+    _mapping: memmap2::MmapMut,
+    store: core::Store,
+}
+static RECORDER: OnceLock<Option<Recorder>> = OnceLock::new();
+
+pub(crate) fn initialize() -> std::io::Result<()> {
+    if RECORDER.get().is_some() {
+        return Ok(());
+    }
+    let value = match std::env::var_os("AIRFRAME_FLIGHT_PATH") {
+        None => None,
+        Some(path) => {
+            let file = std::fs::OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(path)?;
+            // SAFETY: the parent exclusively initializes this bounded file before spawning us.
+            let mut mapping = unsafe { memmap2::MmapOptions::new().map_mut(&file)? };
+            for offset in (0..mapping.len()).step_by(4096) {
+                // Prefault before inference so emitting events requires no page-in I/O.
+                unsafe {
+                    std::ptr::read_volatile(mapping.as_ptr().add(offset));
+                }
+            }
+            let store = unsafe { core::Store::attach(mapping.as_mut_ptr(), mapping.len()) }
+                .map_err(std::io::Error::other)?;
+            Some(Recorder {
+                _mapping: mapping,
+                store,
+            })
+        }
+    };
+    let _ = RECORDER.set(value);
+    emit(1, 0, 0);
+    Ok(())
+}
+
+pub(crate) fn emit(code: u64, a: u64, b: u64) {
+    if let Some(Some(recorder)) = RECORDER.get() {
+        recorder.store.emit(code, a, b);
+    }
+}
