@@ -0,0 +1,69 @@
+//! Memory-only observations of existing HAL synchronization; no additional GPU callbacks.
+mod core;
+use std::sync::OnceLock;
+struct Mapping {
+    pointer: *mut libc::c_void,
+    len: usize,
+}
+unsafe impl Send for Mapping {}
+unsafe impl Sync for Mapping {}
+impl Drop for Mapping {
+    fn drop(&mut self) {
+        unsafe {
+            libc::munmap(self.pointer, self.len);
+        }
+    }
+}
+struct Recorder {
+    _mapping: Mapping,
+    store: core::Store,
+}
+static RECORDER: OnceLock<Option<Recorder>> = OnceLock::new();
+
+pub(crate) fn initialize() {
+    RECORDER.get_or_init(|| {
+        use std::os::fd::AsRawFd;
+        let path = std::env::var_os("AIRFRAME_FLIGHT_PATH")?;
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(path)
+            .ok()?;
+        let len = usize::try_from(file.metadata().ok()?.len()).ok()?;
+        if !(core::HEADER..=core::HEADER + 1_048_576 * core::SLOT).contains(&len) {
+            return None;
+        }
+        let pointer = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                file.as_raw_fd(),
+                0,
+            )
+        };
+        if pointer == libc::MAP_FAILED {
+            return None;
+        }
+        let mapping = Mapping { pointer, len };
+        for offset in (0..len).step_by(4096) {
+            unsafe {
+                std::ptr::read_volatile(pointer.cast::<u8>().add(offset));
+            }
+        }
+        let store = unsafe { core::Store::attach(pointer.cast(), len) }.ok()?;
+        let recorder = Recorder {
+            _mapping: mapping,
+            store,
+        };
+        recorder.store.emit(100, 0, 0);
+        Some(recorder)
+    });
+}
+
+pub(crate) fn emit(code: u64, a: u64, b: u64) {
+    if let Some(Some(recorder)) = RECORDER.get() {
+        recorder.store.emit(code, a, b);
+    }
+}
