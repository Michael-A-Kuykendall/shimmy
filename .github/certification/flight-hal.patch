+//! Fixed-size append-only diagnostic records. No allocation, clock, lock or I/O on emit.
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub const HEADER: usize = 64;
+pub const SLOT: usize = 40;
+pub const MAGIC: u64 = u64::from_le_bytes(*b"AF8KFR01");
+
+pub struct Store {
+    ptr: *mut u8,
+    capacity: u64,
+}
+// SAFETY: callers keep the shared mapping alive; every mutable field is AtomicU64.
+unsafe impl Send for Store {}
+unsafe impl Sync for Store {}
+
+impl Store {
+    /// # Safety
+    /// Mapping must remain live, aligned to 8, writable, and initialized before writers start.
+    pub unsafe fn attach(ptr: *mut u8, len: usize) -> Result<Self, &'static str> {
+        if ptr.is_null() || !(ptr as usize).is_multiple_of(8) || len < HEADER {
+            return Err("invalid mapping");
+        }
+        // SAFETY: the checked mapping covers the aligned header.
+        let word = |i: usize| unsafe { &*ptr.add(i * 8).cast::<AtomicU64>() };
+        if word(0).load(Ordering::Relaxed) != MAGIC {
+            return Err("invalid magic");
+        }
+        let capacity = word(1).load(Ordering::Relaxed);
+        if capacity == 0
+            || capacity > 1_048_576
+            || HEADER as u64 + capacity * SLOT as u64 != len as u64
+        {
+            return Err("invalid capacity");
+        }
+        Ok(Self { ptr, capacity })
+    }
+
+    fn word(&self, byte: usize) -> &AtomicU64 {
+        // SAFETY: attach validates the layout; callers supply checked header/slot offsets.
+        unsafe { &*self.ptr.add(byte).cast::<AtomicU64>() }
+    }
+
+    pub fn emit(&self, code: u64, a: u64, b: u64) {
+        let index = self.word(16).fetch_add(1, Ordering::Relaxed);
+        if index >= self.capacity {
+            self.word(24).fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        let slot = HEADER + index as usize * SLOT;
+        self.word(slot + 8).store(code, Ordering::Relaxed);
+        self.word(slot + 16).store(a, Ordering::Relaxed);
+        self.word(slot + 24).store(b, Ordering::Relaxed);
+        self.word(slot + 32)
+            .store(checksum(index, code, a, b), Ordering::Relaxed);
+        self.word(slot).store(index + 1, Ordering::Release);
+    }
+}
+
+pub fn checksum(index: u64, code: u64, a: u64, b: u64) -> u64 {
+    [index, code, a, b]
+        .iter()
+        .fold(MAGIC, |h, v| (h ^ v).wrapping_mul(1_099_511_628_211))
+}
+
+pub fn label_id(label: &str) -> u64 {
+    label.bytes().fold(1_469_598_103_934_665_603, |h, b| {
+        (h ^ b as u64).wrapping_mul(1_099_511_628_211)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn memory(capacity: usize) -> Vec<u64> {
+        let mut data = vec![0; (HEADER + capacity * SLOT) / 8];
+        data[0] = MAGIC;
+        data[1] = capacity as u64;
+        data
+    }
+    #[test]
+    fn flight_publication_overflow_and_invalid_layout() {
+        let mut data = memory(2);
+        let ptr = data.as_mut_ptr().cast::<u8>();
+        let store = unsafe { Store::attach(ptr, data.len() * 8) }.unwrap();
+        store.emit(7, 11, 13);
+        assert_eq!(store.word(HEADER).load(Ordering::Acquire), 1);
+        assert_eq!(
+            store.word(HEADER + 32).load(Ordering::Relaxed),
+            checksum(0, 7, 11, 13)
+        );
+        store.emit(8, 17, 19);
+        store.emit(9, 23, 29);
+        assert_eq!(store.word(24).load(Ordering::Relaxed), 1);
+        assert!(unsafe { Store::attach(ptr, HEADER) }.is_err());
+        assert!(unsafe { Store::attach(ptr.add(1), data.len() * 8 - 1) }.is_err());
+        data[0] = 0;
+        assert!(unsafe { Store::attach(ptr, data.len() * 8) }.is_err());
+    }
+    #[test]
+    fn flight_concurrent_writers_publish_unique_complete_records() {
+        let mut data = memory(4096);
+        let store = unsafe { Store::attach(data.as_mut_ptr().cast(), data.len() * 8) }.unwrap();
+        std::thread::scope(|scope| {
+            for thread in 0..4 {
+                let store = &store;
+                scope.spawn(move || {
+                    for i in 0..1024 {
+                        store.emit(17, thread, i);
+                    }
+                });
+            }
+        });
+        assert_eq!(store.word(16).load(Ordering::Relaxed), 4096);
+        for i in 0..4096 {
+            let offset = HEADER + i * SLOT;
+            assert_eq!(store.word(offset).load(Ordering::Acquire), i as u64 + 1);
+            let code = store.word(offset + 8).load(Ordering::Relaxed);
+            let a = store.word(offset + 16).load(Ordering::Relaxed);
+            let b = store.word(offset + 24).load(Ordering::Relaxed);
+            assert_eq!(
+                store.word(offset + 32).load(Ordering::Relaxed),
+                checksum(i as u64, code, a, b)
+            );
+        }
+    }
+}
